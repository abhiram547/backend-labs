{
  "info": {
    "_postman_id": "lab04-auth-jwt-collection",
    "name": "Lab 4 - User Registration, Login and JWT Authentication",
    "description": "Postman Collection covering all success and failure cases for Lab 4: User Registration with bcrypt password hashing and Login with JWT authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. POST Register - Valid User (Success 200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"abhiram_sure\",\n  \"name\": \"Sure Abhiram\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Registers a new user, hashes the password using bcrypt with 10 salt rounds, and saves to the SQLite user table."
      }
    },
    {
      "name": "2. POST Register - Duplicate Username (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"abhiram_sure\",\n  \"name\": \"Duplicate User\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Rejects registration when the username already exists in the database with status 400 Bad Request."
      }
    },
    {
      "name": "3. POST Register - Missing Username (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Missing Username\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Validation failure: rejects requests missing required fields with 400 Bad Request."
      }
    },
    {
      "name": "4. POST Register - Short Password (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user_short\",\n  \"name\": \"Short Password User\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        },
        "description": "Rejects passwords less than 6 characters long with 400 Bad Request."
      }
    },
    {
      "name": "5. POST Login - Valid Credentials (Success 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.jwt_token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.jwt_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"abhiram_sure\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Authenticates valid user with bcrypt.compare and returns a signed JWT containing username."
      }
    },
    {
      "name": "6. POST Login - Unknown User (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"non_existent_user\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Rejects login attempt for unregistered username with 400 Bad Request."
      }
    },
    {
      "name": "7. POST Login - Wrong Password (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"abhiram_sure\",\n  \"password\": \"incorrect_pwd\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Rejects login when bcrypt.compare returns false with 400 Bad Request."
      }
    },
    {
      "name": "8. POST Login - Missing Credentials (Failure 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"abhiram_sure\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Validation failure: rejects login request without password with 400 Bad Request."
      }
    },
    {
      "name": "9. GET Profile - Authenticated Request (Success 200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profile"
          ]
        },
        "description": "Verifies JWT token using jwt.verify and returns user profile details."
      }
    },
    {
      "name": "10. GET Profile - Missing Token (Failure 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profile"
          ]
        },
        "description": "Rejects request when Authorization header is omitted with 401 Unauthorized."
      }
    },
    {
      "name": "11. GET Profile - Invalid Token (Failure 401)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_tampered_token_string"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "profile"
          ]
        },
        "description": "Rejects request when JWT verification fails with 401 Unauthorized."
      }
    },
    {
      "name": "12. GET Unknown Route (Failure 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/unknown-route",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "unknown-route"
          ]
        },
        "description": "Returns 404 Not Found with consistent JSON message for unmapped routes."
      }
    }
  ]
}
